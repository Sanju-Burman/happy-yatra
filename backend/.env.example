# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NOTE: .env file is in .gitignore and should NEVER be committed to version control

# Database Connection String
# Replace with your actual MongoDB connection string
MONGO_DB=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/DatabaseName?retryWrites=true&w=majority

# Server Port
PORT=9000

# JWT Secrets (use strong random strings in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_KEY=your-super-secret-access-key-here-change-this-in-production
JWT_REFRESH_KEY=your-super-secret-refresh-key-here-change-this-in-production

# CORS Origins (comma-separated list of allowed frontend domains)
# Development: http://localhost:5173,http://localhost:3000
# Production: https://your-frontend-domain.com,https://api.your-backend-domain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://example.com

# Environment
NODE_ENV=development

# Optional: Cloudinary Credentials (for image uploads)
# CLOUDINARY_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# SMTP Configurations (for email delivery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM="Happy Yatra <noreply@happyyatra.com>"

# Frontend URL
FRONTEND_URL=http://localhost:5173
