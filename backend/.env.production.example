# ==========================================
# Backend Production Environment Variables
# ==========================================
# Copy this file to .env on your production host or set these in your hosting provider's dashboard (Render, Railway, Vercel, AWS, etc.)

# Runtime Environment
NODE_ENV=production
PORT=9000

# MongoDB Atlas Production Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/happy_yatra_prod?retryWrites=true&w=majority
MONGO_DB=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_KEY=replace_with_a_secure_random_64_byte_hex_string
JWT_REFRESH_KEY=replace_with_another_secure_random_64_byte_hex_string

# Allowed Frontend Origins for CORS (Strict comma-separated whitelist, NO trailing slash)
CORS_ORIGIN=https://happyyatra.netlify.app,https://yourcustomdomain.com

# Frontend Public Base URL (Used for generating password reset links in emails)
FRONTEND_URL=https://happyyatra.netlify.app

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_production_google_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.7
GEMINI_CACHE_TTL_HOURS=24

# Cloudinary Storage Configuration (Optional, for avatar & cover image uploads)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or individual credentials:
# CLOUDINARY_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Production Email Delivery (SendGrid, Mailgun, AWS SES, or Brevo SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_smtp_password
SMTP_FROM="Happy Yatra <support@happyyatra.com>"
