# Frontend Environment Variables
# Copy this file to .env and fill in your actual values
# NOTE: .env file is in .gitignore and should NEVER be committed to version control

# Backend API URL
# For development: http://localhost:9000/api
# For production: https://your-backend-domain.com/api
VITE_Backend_API=https://api.example.com/api

# Google Maps API Key
# Get yours from: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Cloudinary URL for image uploads
# VITE_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your-cloud-name
